# Copie para .env para rodar local (docker compose). NUNCA commitar o .env real.
# No Coolify estas senhas são geradas sozinhas (SERVICE_PASSWORD_*) — só
# ADMIN/TMDB precisam ser vistos/ajustados na aba "Environment Variables".

SERVICE_PASSWORD_MYSQLROOT=troque_esta_senha_root
SERVICE_PASSWORD_MYSQL=troque_esta_senha_app
MYSQL_DATABASE=iptv
MYSQL_USER=iptv_app

# Login do painel (usuário admin). Em branco => senha aleatória aparece nos logs
# do container "app" na primeira subida.
ADMIN_USERNAME=admin
SERVICE_PASSWORD_ADMIN=troque_esta_senha_admin

# Chave grátis do TMDB (opcional — capas/sinopses do catálogo VOD)
TMDB_API_KEY=

# Token do GitHub (opcional, sem escopos) — habilita a busca de listas por código em "Importar fontes"
GITHUB_TOKEN=

# Senha pedida pra abrir o conteúdo adulto (opcional; padrão 0000)
ADULT_PIN=

# Cookie de sessão só por HTTPS. Use false apenas em teste local sem TLS.
COOKIE_SECURE=false

# Porta publicada no host (uso local)
API_PORT=7678
