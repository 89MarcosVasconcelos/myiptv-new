# -----------------------------------------------------------------------
# Modelo de variaveis de ambiente para o deploy em producao (Coolify/Linux).
# Copie os valores relevantes pra secao de "Environment Variables" da
# aplicacao no Coolify — NAO e pra usar este arquivo direto no servidor.
# -----------------------------------------------------------------------

APP_NAME="IPTV do MP"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Dominio final do projeto (o alias do registro.br que voce vai configurar).
# Sem isso, links absolutos gerados pelo Laravel (emails, redirects) apontam
# pro IP em vez do dominio.
APP_URL=https://SEU-DOMINIO-AQUI

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

BCRYPT_ROUNDS=12

# FFPROBE_PATH nao e definido aqui de proposito: no Linux, com o ffmpeg
# instalado via apk (ja incluso na imagem Docker), o padrao 'ffprobe'
# resolve sozinho pelo PATH — o caminho do Windows (C:\ffmpeg\...) nao se
# aplica aqui.

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# Banco gerenciado separadamente no Coolify (recurso de MySQL proprio, com
# backup automatico) — aponte aqui pro host/porta que ele expuser.
DB_CONNECTION=mysql
DB_HOST=SEU_HOST_MYSQL_AQUI
DB_PORT=3306
DB_DATABASE=myiptv
DB_USERNAME=myiptv
DB_PASSWORD=SENHA_FORTE_AQUI

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_DOMAIN=null
# Necessario com HTTPS na frente (Coolify/Traefik) pra cookie de sessao ir
# so por conexao segura.
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log

VITE_APP_NAME="${APP_NAME}"

# Chaves gratuitas para o enriquecimento de metadados (botao "Preencher
# lacunas" em Itens carregados). Gere em:
# TMDB: https://www.themoviedb.org/settings/api
# OMDB: https://www.omdbapi.com/apikey.aspx
TMDB_API_KEY=
OMDB_API_KEY=
